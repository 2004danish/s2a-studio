// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Phase 1 Tech Stack requirement
  
}

// 1. USERS: Admin access only for now
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
}

// 2. PROJECTS: Core details, images, categories, case study text
model Project {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  category         String
  heroImage        String?
  problemStatement String?
  caseStudyText    String?
  gallery          String[] // We will store Cloudinary image URLs here
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// 3. LEADS: Contact form submissions
model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}